# ============================================================
# PORTFOLIO ENVIRONMENT — contoh konfigurasi
# Salin file ini menjadi `.env.local` lalu isi nilainya.
# SEMUA variabel opsional — tanpa env, aplikasi tetap jalan
# memakai data default dari src/dearlyfebriano/data/profile.ts.
# ============================================================

# --- Email (opsional) ----------------------------------------
# Daftar gratis di https://resend.com (100 email/hari).
# Tanpa API key, pesan contact form tetap tersimpan ke store.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# PERSONAL_EMAIL=dearlyfebrianoi@gmail.com
# RESEND_FROM="Portfolio Contact <onboarding@resend.dev>"

# --- Admin "Manage" mode (guestbook & contact) ---------------
# Key untuk mode "Manage" (tombol shield) di halaman Guestbook dan
# Contact (section "Recent messages"). GET + DELETE pada
# /api/contact serta DELETE /api/guestbook memerlukan header
# x-admin-key yang cocok dengan nilai ini.
# Tanpa env, default: dearlyfebriano08
# ADMIN_DELETE_KEY=your-secret-admin-key

# --- Public config (opsional, override data profile.ts) ------
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
# NEXT_PUBLIC_WA_NUMBER=6283854436555
# NEXT_PUBLIC_WA_MESSAGE=Hi Dearly! I found your portfolio and would love to connect!
